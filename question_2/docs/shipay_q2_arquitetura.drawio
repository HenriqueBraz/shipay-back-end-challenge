        <mxCell id="codeTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" value="ALTERAÇÃO NO ENDPOINT EXISTENTE" vertex="1">
