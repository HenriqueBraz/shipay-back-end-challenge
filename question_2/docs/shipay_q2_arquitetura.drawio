        </mxCell>
        <mxCell id="queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" value="SQS — Reporting Queue&lt;br&gt;&lt;br&gt;┌────────────────────────┐&lt;br&gt;│ RocketLaunchedEvent │&lt;br&gt;│ RocketLaunchedEvent │&lt;br&gt;│ RocketLaunchedEvent │&lt;br&gt;└────────────────────────┘&lt;br&gt;&lt;br&gt;Durabilidade / desacoplamento" vertex="1">
          <mxGeometry height="215" width="300" x="1200" y="850" as="geometry" />
        </mxCell>
        <mxCell id="consumer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" value="Reporting Consumer&lt;br&gt;&lt;br&gt;1. recebe mensagem&lt;br&gt;2. persiste no Reporting DB&lt;br&gt;3. ACK somente após sucesso&lt;br&gt;4. retry + backoff em falhas" vertex="1">
