        <mxCell id="before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFF99;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;" value="ANTES&lt;br&gt;&lt;br&gt;&lt;pre style=&quot;margin:0;font-family:monospace;font-size:12px;text-align:left;&quot;&gt;return await service.launch(trace_id=trace_id,&lt;br&gt;                            customer_id=schema.customer_id,&lt;br&gt;                            countdown_status=countdown_status,&lt;br&gt;                            pre_flight=pre_flight)&lt;/pre&gt;" vertex="1">
          <mxGeometry height="115" width="760" x="90" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99FF99;strokeColor=#b85450;fontSize=13;fontStyle=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DEPOIS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;async def launch(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;request: Request, schema: LaunchRequestBody = None,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px;&quot;&gt;service:&lt;br&gt;LaunchService=Depends(Provide[Container.launch_service]),&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px;&quot;&gt;reporting_event_publisher: ReportingEventPublisher=Depends(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px;&quot;&gt;Provide[Container.reporting_event_publisher]&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px;&quot;&gt;)):&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;undefined&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(0, 29, 53); font-size: 14px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;...&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;pre style=&quot;margin: 0px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;launch_result = await service.launch(trace_id=trace_id,&lt;br&gt;                              customer_id=schema.customer_id,&lt;br&gt;                              countdown_status=countdown_status,&lt;br&gt;                              pre_flight=pre_flight)&lt;br&gt;&lt;br&gt;event_id = str(uuid4())&lt;br&gt;try:&lt;br&gt;    event = RocketLaunchedEvent(&lt;br&gt;&lt;/span&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;event&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;_id=event_id&lt;/span&gt;,&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;    trace_id=trace_id,&lt;br&gt;    customer_id=schema.customer_id,&lt;br&gt;    launched_at=...)&lt;br&gt;&lt;br&gt;    await reporting_event_publisher.publish(event)&lt;br&gt;&lt;br&gt;except Exception as exception:&lt;br&gt;   # registrar a ocorrência para recuperação: event_id, etc&lt;br&gt;    pass&lt;br&gt;&lt;br&gt;return launch_result&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
