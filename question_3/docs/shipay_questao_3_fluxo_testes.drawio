        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="&lt;b&gt;Q3 — Fluxo do Agendador e Testes de Performance&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="1480" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="&lt;b&gt;1. WORKFLOW&lt;/b&gt;&lt;br&gt;Passos antes do agendamento&lt;br&gt;&lt;br&gt;Envia o POST ao Scheduler" vertex="1">
          <mxGeometry height="120" width="230" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="&lt;b&gt;2. SCHEDULER&lt;/b&gt;&lt;br&gt;POST /v1/render/scheduler&lt;br&gt;&lt;br&gt;enqueue_at(datetime, publish_event, event_content)" vertex="1">
          <mxGeometry height="140" width="280" x="340" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="&lt;b&gt;3. RQ / REDIS&lt;/b&gt;&lt;br&gt;RQ Queue + Redis&lt;br&gt;&lt;br&gt;Job fica agendado até o horário" vertex="1">
          <mxGeometry height="120" width="250" x="680" y="140" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" value="&lt;b&gt;4. RQ WORKER&lt;/b&gt;&lt;br&gt;Executa o job quando o horário chega&lt;br&gt;&lt;br&gt;→ publish_event(event_content)" vertex="1">
          <mxGeometry height="140" width="280" x="990" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="&lt;b&gt;5. KAFKA → SUBSCRIBER&lt;/b&gt;&lt;br&gt;Publica no tópico de verificação&lt;br&gt;&lt;br&gt;Subscriber recebe e o workflow continua" vertex="1">
