        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#33FF33;strokeColor=#666666;fontSize=11;" value="&lt;div&gt;• users.role_id → roles.id (FK)&lt;/div&gt;&lt;div&gt;• users ↔ claims via user_claims&lt;/div&gt;&lt;div&gt;• não há UNIQUE(email)&lt;/div&gt;&lt;div&gt;• claims não participam do fluxo deste endpoint&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="260" x="50" y="630" as="geometry" />
        </mxCell>
        <mxCell id="test" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="Testes&#xa;Schema + Service + Model + API" vertex="1">
