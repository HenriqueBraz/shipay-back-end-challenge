        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" value="FastAPI&#xa;Endpoint / Controller" vertex="1">
          <mxGeometry height="70" width="190" x="295" y="90" as="geometry" />
