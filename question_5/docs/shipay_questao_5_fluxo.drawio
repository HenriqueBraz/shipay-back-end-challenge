        <mxCell id="schema" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div&gt;&lt;b&gt;Pydantic Schema&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• name obrigatório&amp;nbsp;&lt;/div&gt;&lt;div&gt;• email válido&amp;nbsp;&lt;/div&gt;&lt;div&gt;• role_id obrigatório&amp;nbsp;&lt;/div&gt;&lt;div&gt;• password opcional&lt;/div&gt;" vertex="1">
